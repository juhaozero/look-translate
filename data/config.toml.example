# Example only. Runtime file is created next to the executable under `data/config.toml`.
[general]
target_lang = "zh-CN"
source_lang = "auto"
hotkey_translate = "Shift+Q"
hotkey_ocr = "Ctrl+Shift+D"
hotkey_input = "Ctrl+Shift+T"
hotkey_enabled = true
follow_system_proxy = true
launch_at_startup = true

[engine]
active = "microsoft"
# 并行启用多个引擎（可选；省略时等同 actives = [active]）：
# actives = ["microsoft_web", "google_web", "cloudflare"]
# microsoft_api_key = "your-key"
# microsoft_region = "eastasia"  # regional / multi-service resources only
# google_api_key = "your-google-cloud-translation-v2-key"
# active = "microsoft_web"  # unofficial Bing web (no key)
# active = "google"         # Cloud Translation API v2
# active = "google_web"     # unofficial gtx endpoint (no key)
# Cloudflare Workers (translate-api compatible):
# active = "cloudflare"
# cloudflare_endpoint = "https://your-worker.workers.dev/"
# cloudflare_secret = "123456"
#
# Baidu Translate open platform (通用翻译 API):
# active = "baidu"
# baidu_app_id = "your-app-id"
# baidu_secret = "your-secret"
#
# Youdao Zhiyun text translation:
# active = "youdao"
# youdao_app_key = "your-app-key"
# youdao_app_secret = "your-app-secret"
#
# DeepL official API (Free keys end in :fx; other keys use Pro):
# deepl_api_key = "your-api-key:fx"
# active = "deepl"

[ocr]
engine = "system"
# engine = "tesseract"  # Tesseract.js (eng+chi_sim) in the webview

[dictionary]
enabled = true
# First path only. Relative paths resolve against this data/ directory.
# Recommended ECDICT install target (settings:「安装 ECDICT 推荐词典」):
# paths = ["dicts/ecdict.mdx"]
paths = []
# paths = ["D:/dicts/oxford.mdx"]
